# ==============================================================================
# ACHME Communication CRM - Docker Environment Configuration Template
# ==============================================================================

# Server Configuration
NODE_ENV=production
PORT=5000
ALLOWED_ORIGIN=http://localhost:3000
DEFAULT_TEST_PASSWORD=Test@12345

# Database Configuration (Docker Internal & Host Exposed)
# Note: Inside the containers, the backend connects to "mysql" host name.
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
DB_NAME=achme

# MySQL Container ROOT Password (used for authentication & setup)
MYSQL_ROOT_PASSWORD=admin@123

# Email Configurations for CRM Notifications & Alerts
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAIL_USER=thanan757@gmail.com
EMAIL_PASS=ghjv omqm hwji kerq

# JWT Authentication Secret Key
JWT_SECRET=97418d0c15d57ade768586b8501e35d34e5a5277f2a0570b6d5b47ef93f5b33e88b80045c60efd77e6edcbb015dbe46cf6747ce1dd8f11361f3e426ddc677c9a

# Frontend Endpoint configuration
REACT_APP_API_URL=http://localhost:5000

# WhatsApp Cloud API (Meta Official)
# Get these from: https://developers.facebook.com/apps -> Your App -> WhatsApp -> Getting Started
WA_PHONE_NUMBER_ID=your_phone_number_id
WA_ACCESS_TOKEN=your_access_token
WA_WABA_ID=your_waba_id
WA_APP_SECRET=your_app_secret
WA_VERIFY_TOKEN=crm_verify_123
WA_BUSINESS_ACCOUNT_ID=your_business_account_id

# Public base URL of THIS backend, used to turn relative media paths
# (e.g. /uploads/wa-media/brochure.pdf) into absolute links that WhatsApp can fetch.
# Must be publicly reachable for Meta Cloud API media to work.
PUBLIC_BASE_URL=http://localhost:5000

# Redis for WhatsApp message queue (BullMQ)
REDIS_URL=redis://localhost:6379

# Interval between WhatsApp messages in ms (default 2000ms = 2 seconds)
WA_MESSAGE_INTERVAL=2000
