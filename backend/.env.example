# =========================
# WhatsApp (optional)
# =========================
# Meta Cloud API — leave blank to use the free WhatsApp Web session engine instead.
# When WA_APP_SECRET is set, inbound webhook requests are verified via X-Hub-Signature-256.
# WA_PHONE_NUMBER_ID=
# WA_ACCESS_TOKEN=
# WA_WABA_ID=
# WA_APP_SECRET=
# WA_VERIFY_TOKEN=crm_verify_123

# WhatsApp Web engine — which WhatsApp Web build the linked-device session runs.
# Defaults to a pinned known-good build. If scanning the QR links your phone but
# the session is immediately dropped ("disconnected: LOGOUT" in the server log),
# the pin has aged out — WhatsApp rejects web builds it considers too old.
# Set to "latest" to let it negotiate the live build instead.
# WA_WEB_VERSION=latest

# AI auto-reply — can also be set from the WhatsApp Accounts page in the UI instead.
# Get a free key at https://openrouter.ai
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
